<?xml version="1.0" encoding="utf-8"?>
<!-- Joy Launcher (안드로이드). 버전 이름·번호, 최소·대상 SDK 는 빌드할 때 넣는다 (android/build_apk.sh) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jyjylab.joylauncher"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 테마 내려받기·업데이트 확인, PC 에서 테마 받기(FTP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 롬 폴더 읽기 + 저장소 루트의 JoyLauncher 폴더(설정·테마). 안드로이드 11 이상은 "모든 파일 접근" -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 설치된 에뮬레이터 확인, 앱 목록(앱 즐겨찾기) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@style/JoyTheme">

        <activity
            android:name=".JoyActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 게임 파일을 에뮬레이터에 넘기는 파일 제공자 ({file.uri}, %ROMPROVIDER%). 인텐트마다 그 파일만 읽게 허용 -->
        <provider
            android:name=".JoyFileProvider"
            android:authorities="com.jyjylab.joylauncher.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
